# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./data/shipreward.db

# GitHub Integration & Webhook Security
# The secret configured in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Optional GitHub Personal Access Token (for fetching PR diffs and CI checks)
GITHUB_TOKEN=your_github_pat_token_here

# Bitrefill Commerce Configuration
# Bitrefill API Key / OAuth Bearer Token (Keep server-side only! Never expose to client)
BITREFILL_API_KEY=your_bitrefill_api_key_here
BITREFILL_MCP_URL=https://api.bitrefill.com/mcp
BITREFILL_API_URL=https://api.bitrefill.com/v2

# Spend Guardrails & Emergency Controls
# Hard daily cap in USD
SPEND_CAP_DAILY_USD=25.00
# Maximum reward for a single contribution in USD
SPEND_CAP_SINGLE_REWARD_USD=10.00
# Emergency killswitch: Set to true to freeze all autonomous purchases instantly
EMERGENCY_PURCHASE_FREEZE=false

# Auto-fulfillment: Set to false to require manual review for all rewards
AUTO_PURCHASE_ENABLED=true
